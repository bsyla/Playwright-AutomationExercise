TEST_ENV=staging

# Base URLs per environment
BASE_URL_LOCAL=http://localhost:3000
BASE_URL_STAGING=https://automationexercise.com
BASE_URL_PROD=https://automationexercise.com

# API base (defaults to BASE_URL_* if omitted)
API_BASE_URL=

# Optional: pre-existing credentials for manual runs
E2E_USERNAME=
E2E_PASSWORD=

# Optional: override storage state path
AUTH_STORAGE_STATE=.auth/user.json
